# Consumer key from https://developer.ticketmaster.com
TICKETMASTER_API_KEY=

# Local: postgresql://daysout:daysout@localhost:5433/daysout
# Neon/Supabase: paste the URI, keep sslmode=require
DATABASE_URL=postgresql://daysout:daysout@localhost:5433/daysout

# Set to 0 on Vercel (10s timeout). GitHub Action should do the ingest there.
AUTO_PULL=1
